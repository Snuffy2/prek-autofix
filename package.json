{
  "name": "prek-autofix",
  "version": "1.0.7",
  "private": true,
  "description": "Safely apply prek fixes to pull request branches",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:collect && npm run build:apply",
    "build:collect": "esbuild packages/collect/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/collect/index.js --minify --banner:js='var import_meta_url = require(\"node:url\").pathToFileURL(__filename).href;' --define:import.meta.url=import_meta_url",
    "build:apply": "esbuild packages/apply/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/apply/index.js --minify --banner:js='var import_meta_url = require(\"node:url\").pathToFileURL(__filename).href;' --define:import.meta.url=import_meta_url",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "glob": "^13.0.6",
    "undici": "^6.27.0"
  },
  "allowScripts": {
    "fsevents": true,
    "esbuild": true
  }
}
