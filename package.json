{
  "name": "prek-autofix",
  "version": "0.1.0",
  "private": true,
  "description": "Safely apply prek fixes to pull request branches",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:collect && npm run build:apply",
    "build:collect": "esbuild packages/collect/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/collect/index.js --minify",
    "build:apply": "esbuild packages/apply/src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/apply/index.js --minify",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "undici": "^6.27.0"
  }
}
