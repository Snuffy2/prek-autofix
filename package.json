{
  "name": "prek-autofix",
  "version": "1.1.1",
  "private": true,
  "description": "Safely apply prek fixes to pull request branches",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:collect && npm run build:apply",
    "build:collect": "node .github/scripts/build.mjs collect",
    "build:apply": "node .github/scripts/build.mjs apply",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "glob": "^13.0.6",
    "undici": "^6.27.0"
  },
  "allowScripts": {
    "fsevents": true,
    "esbuild": true
  }
}
